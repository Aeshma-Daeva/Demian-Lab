  "hypotheses": [
    {
      "id": "H-ROUTE-001",
      "statement": "Matched gate variation changes the timing or strength of specific implemented routes.",
      "operational_prediction": "Matched acute gate interventions change preregistered downstream route contributions at predicted delays.",
      "evidence_status": "untested",
      "falsifier": "Held-out matched interventions produce no route-specific downstream difference beyond sham variation."
    },
    {
      "id": "H-ROUTE-002",
      "statement": "Similar exposed trajectories can coexist with systematically different route trajectories.",
      "operational_prediction": "Readout-matched held-out trajectories separate by preregistered route summaries after residual and history matching.",
      "evidence_status": "untested",
      "falsifier": "Route differences disappear after readout, hidden-distance, reachability, and history matching."
    },
    {
      "id": "H-ROUTE-003",
      "statement": "Selected route sequences mediate delayed effects on internal state or readout.",
      "operational_prediction": "Route removal changes the predicted downstream outcome and original-contribution rescue restores it.",
      "evidence_status": "untested",
      "falsifier": "Removal and rescue fail to alter or restore the preregistered downstream outcome."
    }
  ],
  "recording": {
    "retain_absolute_l2": true,
    "normalizations": ["target_state_l2", "target_update_l2", "declared_channel_scale"],
    "temporal_summaries": ["activation", "persistence", "alignment", "cancellation", "dominant_route_sequence"],
    "active_l2_epsilon": 1e-09
  },
  "interventions": [
    {"id":"one_step_removal","semantics":"Zero one named route contribution for one transition.","required_controls":["sham","matched_untargeted_route","held_out_seed"]},
    {"id":"sustained_removal","semantics":"Zero one named route contribution over a preregistered window.","required_controls":["sham","matched_untargeted_route","held_out_seed"]},
    {"id":"frozen_modulation","semantics":"Hold one multiplicative modulator at its intervention-time value.","required_controls":["sham","matched_intervention_time","held_out_seed"]},
    {"id":"contribution_replacement","semantics":"Replace one named contribution with a matched control contribution.","required_controls":["sham","amplitude_match","held_out_seed"]},
    {"id":"original_contribution_rescue","semantics":"Replay the uninterrupted contribution sequence after targeted removal.","required_controls":["removal_arm","sham","runtime_metadata_match"]}
  ],
  "interpretation_rules": [
    "Route tracing is defined for the active gate update rule; disabled and frozen overrides require explicit discarded-branch semantics.",
    "A route sequence is descriptive until intervention establishes a delayed downstream effect.",
    "Lagged association is not transmission.",
    "Persistent contributions may cancel and do not establish AFP-v2.",
    "Route attribution is implementation-coordinate dependent.",
