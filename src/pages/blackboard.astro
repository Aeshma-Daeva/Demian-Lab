---
import Base from '../layouts/Base.astro';
import blackboard from '../data/blackboard.json';
import { getPublicPosts } from '../lib/feeds';

const posts = (await getPublicPosts()).slice(0, 6);
const base = import.meta.env.BASE_URL;
---
<Base title="Blackboard — Demian Lab" description="Current public status for recurrent-state and operational-epistemology experiments.">
  <style>
    h1 { font-size: 1.4rem; font-weight: 400; margin-bottom: 0.25rem; }
    .sub { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-bottom: 2rem; }
    .panel { border-top: 1px solid var(--border); padding: 1.5rem 0; }
    .panel h2 { font-family: var(--mono); font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; }
    .latest { color: var(--text); max-width: 620px; }
    .status-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
    .stat { background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--accent); padding: 1rem; }
    .stat-val { display: block; font-family: var(--mono); color: var(--accent); font-size: 1rem; }
    .stat-label { display: block; font-family: var(--mono); color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 2px; }
    ul { list-style: none; display: grid; gap: 0.65rem; }
    li { color: #d0d0d0; font-size: 0.92rem; }
    .artifact, .entry { display: grid; grid-template-columns: 120px 1fr; gap: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.65rem; }
    .date, .path { font-family: var(--mono); font-size: 11px; color: var(--muted); }
    .entry a, .artifact span:first-child { color: var(--text); }
    .feeds { display: flex; gap: 1rem; flex-wrap: wrap; font-family: var(--mono); font-size: 12px; }
    @media (max-width: 600px) {
      .artifact, .entry { grid-template-columns: 1fr; gap: 0.2rem; }
    }
  </style>

  <h1>Research blackboard</h1>
  <p class="sub">phase: {blackboard.phase} · updated: {blackboard.updated}</p>

  <section class="panel">
    <h2>latest result</h2>
    <p class="latest">{blackboard.latestResult}</p>
  </section>

  <section class="panel">
    <h2>status</h2>
    <div class="status-grid">
      {blackboard.status.map(item => (
        <div class="stat">
          <span class="stat-val">{item.value}</span>
          <span class="stat-label">{item.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="panel">
    <h2>active objectives</h2>
    <ul>
      {blackboard.objectives.map(item => <li>{item}</li>)}
    </ul>
  </section>

  <section class="panel">
    <h2>recent entries</h2>
    <ul>
      {posts.map(post => (
        <li class="entry">
          <span class="date">{post.data.date.toISOString().slice(0, 10)}</span>
          <a href={`${base}log/${post.slug}`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>artifacts</h2>
    <ul>
      {blackboard.artifacts.map(item => (
        <li class="artifact">
          <span>{item.label}</span>
          <span class="path">{item.path}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>claim boundaries</h2>
    <ul>
      {blackboard.claimBoundaries.map(item => <li>{item}</li>)}
    </ul>
  </section>

  <section class="panel">
    <h2>bot feeds</h2>
    <div class="feeds">
      <a href={`${base}updates.json`}>updates.json</a>
      <a href={`${base}rss.xml`}>rss.xml</a>
    </div>
  </section>
</Base>
