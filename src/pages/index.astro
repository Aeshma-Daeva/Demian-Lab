const CHANNELS = {
  carrier:{shape:'(1,32)',range:'[-36.6, 54.1]',color:'#5fffaa',desc:"Main integration channel. Receives the projected EEG surface features and carries the compressed session state."},
  control:{shape:'(1,4)',range:'[-2.5, 1.8]',color:'#f0b429',desc:"Low-dimensional steering signal. Small shape, large influence over gain and routing."},
  fast:{shape:'(1,32)',range:'[-0.6, 0.6]',color:'#60a5fa',desc:"Fast-timescale channel. Reacts to rapid changes and competes with the slow channel for dominance."},
  gate:{shape:'(1,32)',range:'[-126.0, 103.5]',color:'#c084fc',desc:"Gate modulator. Controls information flow between channels. Its large final norm shows the gate is actively shaping the run."},
  message:{shape:'(1,32)',range:'[-9.7, 8.5]',color:'#fb923c',desc:"Communication channel between trisequence components: self, other/input, context."},
  slow:{shape:'(1,32)',range:'[-17.3, 11.5]',color:'#34d399',desc:"Slow-timescale channel. Integrates longer context and stabilizes the route when fast dynamics spike."}
};

function mkChart(id,labels,datasets,type='line',opts={}){
  const ctx=document.getElementById(id);
  if(!ctx)return;
  const base={responsive:true,maintainAspectRatio:false,animation:false,
    plugins:{legend:{display:datasets.length>1,labels:{boxWidth:10,font:{size:10},color:'#666'}},tooltip:{mode:'index',intersect:false,backgroundColor:'#161616',titleColor:'#666',bodyColor:'#e2e2e2',borderColor:'#252525',borderWidth:1}},
    scales:{x:{ticks:{color:'#444',font:{size:9},maxTicksLimit:8},grid:{color:'#181818'},border:{color:'#252525'}},y:{ticks:{color:'#444',font:{size:9},maxTicksLimit:5},grid:{color:'#181818'},border:{color:'#252525'}}}
  };
  return new Chart(ctx,{type,data:{labels,datasets},options:{...base,...opts}});
}

function lineDs(label,data,color,fill=false){
  return{label,data,borderColor:color,backgroundColor:fill?color+'22':'transparent',borderWidth:1.5,pointRadius:0,tension:0.3,fill};
}

window.addEventListener('load',()=>{
  const T=DATA.times;
  mkChart('chart-tension',T,[lineDs('tension stored',DATA.tension,'#5fffaa'),lineDs('uncertainty',DATA.uncertainty,'#f0b429')]);
  mkChart('chart-reservoir',T,[lineDs('reservoir',DATA.reservoir,'#5fffaa',true)]);
  mkChart('chart-tort',T,[lineDs('tortuosity',DATA.tortuosity,'#60a5fa',true)]);
  mkChart('chart-cos',T,[lineDs('self/other cosine',DATA.self_other,'#f87171')]);
  mkChart('chart-pred',T,[lineDs('prediction error',DATA.pred_error,'#fb923c')]);
  mkChart('chart-coupling',T,[lineDs('mean |coupling|',DATA.coupling_mean,'#c084fc')]);
  mkChart('chart-fastslow',T,[lineDs('fast/slow ratio',DATA.fast_slow,'#60a5fa')]);
  mkChart('chart-gate',T,[lineDs('gate state norm',DATA.gate_norm,'#c084fc',true)]);
  mkChart('chart-fs2',T,[lineDs('fast/slow ratio',DATA.fast_slow,'#60a5fa')]);

  // coupling heatmap
  const heat=document.getElementById('coupling-heat');
  DATA.coupling_final.forEach((v,i)=>{
    const cell=document.createElement('div');
    cell.className='coupling-cell';
    const abs=Math.abs(v);
    const pos=v>0;
    const alpha=0.2+abs*0.8;
    cell.style.background=pos?`rgba(95,255,170,${alpha})`:`rgba(248,113,113,${alpha})`;
    cell.title=`dim ${i}: ${v.toFixed(3)}`;
    heat.appendChild(cell);
  });

  // channel cards
  const grid=document.getElementById('ch-grid');
  Object.entries(CHANNELS).forEach(([name,ch])=>{
    const card=document.createElement('div');
    card.className='ch-card';
    card.innerHTML=`<div class="ch-name">${name}</div><div class="ch-dim">shape ${ch.shape}</div><div class="ch-desc">${ch.desc.slice(0,60)}…</div><div class="ch-range">${ch.range}</div>`;
    card.onclick=()=>{
      document.querySelectorAll('.ch-card').forEach(c=>c.classList.remove('selected'));
      card.classList.add('selected');
      const d=document.getElementById('ch-detail');
      d.innerHTML=`<div class="panel-title" style="color:${ch.color}">${name} channel</div>
        <div style="font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:1rem">shape: ${ch.shape} &nbsp;·&nbsp; range: ${ch.range}</div>
        <p style="font-size:13px;color:var(--dim);line-height:1.8;margin-bottom:1.25rem">${ch.desc}</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
          <div class="stat-card"><div class="stat-val" style="color:${ch.color};font-size:.9rem">${ch.shape}</div><div class="stat-label">tensor shape</div></div>
          <div class="stat-card"><div class="stat-val" style="color:${ch.color};font-size:.9rem">${ch.range}</div><div class="stat-label">final state range</div></div>
        </div>`;
    };
    grid.appendChild(card);
  });
});

function showPage(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
  const page=document.getElementById('page-'+id);
  if(page)page.classList.add('active');
  const evt=window.event;
  if(evt && evt.target && evt.target.classList && evt.target.classList.contains('nav-tab')){
    evt.target.classList.add('active');
  }else{
    const label={overview:'Overview',architecture:'Architecture',eeg:'EEG Mapping',experiments:'Experiments',log:'Log',blackboard:'Blackboard'}[id];
    const tab=[...document.querySelectorAll('.nav-tab')].find(t=>t.textContent.trim()===label);
    if(tab)tab.classList.add('active');
  }
}
window.showPage = showPage;
</script>
</body>
</html>
