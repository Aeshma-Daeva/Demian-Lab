<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Demian Lab — Public Blackboard Preview</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style is:global>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#080808;--s1:#0f0f0f;--s2:#161616;--s3:#1e1e1e;
  --border:#252525;--border2:#333;
  --text:#e2e2e2;--muted:#666;--dim:#444;
  --green:#5fffaa;--green2:rgba(95,255,170,0.12);--green3:rgba(95,255,170,0.04);
  --amber:#f0b429;--amber2:rgba(240,180,41,0.12);
  --blue:#60a5fa;--blue2:rgba(96,165,250,0.1);
  --red:#f87171;--red2:rgba(248,113,113,0.1);
  --mono:'IBM Plex Mono',monospace;
  --sans:'IBM Plex Sans',sans-serif;
}
html{background:var(--bg);color:var(--text);font-family:var(--sans);font-size:15px;line-height:1.6}
body{min-height:100vh;display:flex;flex-direction:column}

/* NAV */
nav{
  position:sticky;top:0;z-index:100;
  background:var(--bg);border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 2rem;height:48px;
}
.nav-logo{font-family:var(--mono);font-size:13px;color:var(--green);letter-spacing:.05em}
.nav-tabs{display:flex;height:100%}
.nav-tab{
  font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;
  color:var(--muted);border:none;background:none;cursor:pointer;
  padding:0 1.25rem;border-bottom:2px solid transparent;
  transition:color .15s,border-color .15s;
}
.nav-tab:hover{color:var(--text)}
.nav-tab.active{color:var(--green);border-bottom-color:var(--green)}
.nav-right{display:flex;align-items:center;gap:1rem}
.badge-live{
  font-family:var(--mono);font-size:10px;letter-spacing:.08em;
  background:var(--green2);color:var(--green);
  padding:2px 8px;border-radius:2px;border:1px solid rgba(95,255,170,.25);
}
.badge-live::before{content:'● ';font-size:8px}
.nav-link{
  font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;
  color:var(--muted);text-decoration:none;border:1px solid var(--border);
  padding:2px 8px;border-radius:2px;
}
.nav-link:hover{color:var(--green);border-color:rgba(95,255,170,.35);text-decoration:none}

/* LAYOUT */
main{flex:1;padding:0}
.page{display:none;padding:2rem}
.page.active{display:block}

/* SECTION HEADERS */
.section-label{
  font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--muted);margin-bottom:1.25rem;
  display:flex;align-items:center;gap:.75rem;
}
.section-label::after{content:'';flex:1;height:1px;background:var(--border)}
h2{font-size:1rem;font-weight:400;margin-bottom:.25rem}

/* STAT CARDS */
.stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:2rem}
.stat-card{
  background:var(--s1);border:1px solid var(--border);
  padding:.875rem 1rem;
}
.stat-card.accent{border-left:2px solid var(--green);background:var(--green3)}
.stat-val{font-family:var(--mono);font-size:1.35rem;font-weight:500;line-height:1;margin-bottom:.35rem}
.stat-val.green{color:var(--green)}
.stat-val.amber{color:var(--amber)}
.stat-val.blue{color:var(--blue)}
.stat-val.red{color:var(--red)}
.stat-label{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.stat-sub{font-size:11px;color:var(--dim);margin-top:4px}

/* GRID LAYOUTS */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1.25rem;margin-bottom:1.5rem}
.grid-arch{display:grid;grid-template-columns:1fr 1.6fr;gap:1.5rem;margin-bottom:2rem}
@media(max-width:900px){.grid-2,.grid-3,.grid-arch{grid-template-columns:1fr}}

/* PANELS */
.panel{background:var(--s1);border:1px solid var(--border);padding:1.25rem}
.panel-title{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem;display:flex;align-items:center;justify-content:space-between}

/* CHART WRAPPERS */
.chart-wrap{position:relative;width:100%}

/* ARCHITECTURE — channel cards */
.channel-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.ch-card{
  background:var(--s2);border:1px solid var(--border);
  padding:.75rem;cursor:pointer;transition:border-color .15s,background .15s;
}
.ch-card:hover,.ch-card.selected{border-color:var(--green);background:var(--green3)}
.ch-name{font-family:var(--mono);font-size:12px;color:var(--green);font-weight:500;margin-bottom:4px}
.ch-dim{font-family:var(--mono);font-size:10px;color:var(--muted);margin-bottom:.5rem}
.ch-desc{font-size:11px;color:var(--dim);line-height:1.5}
.ch-range{font-family:var(--mono);font-size:10px;color:var(--amber);margin-top:6px}

/* EEG MAPPING */
.band-table{width:100%;border-collapse:collapse;font-size:12px}
.band-table th{font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);padding:6px 10px;text-align:left;border-bottom:1px solid var(--border)}
.band-table td{padding:7px 10px;border-bottom:1px solid var(--border);color:var(--dim)}
.band-table td:first-child{font-family:var(--mono);color:var(--green);font-size:11px}
.band-table td:nth-child(2){color:var(--text)}
.band-bar-wrap{background:var(--s3);height:4px;border-radius:2px;min-width:60px}
.band-bar{height:4px;border-radius:2px;background:var(--green);transition:width .3s}

/* REGION MAP */
.brain-regions{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.region{
  background:var(--s2);border:1px solid var(--border);
  padding:.6rem .5rem;text-align:center;
}
.region-name{font-family:var(--mono);font-size:10px;color:var(--green);margin-bottom:4px}
.region-val{font-family:var(--mono);font-size:13px;color:var(--text)}
.region-sub{font-size:10px;color:var(--muted)}

/* COUPLING HEATMAP */
.coupling-heat{
  display:grid;grid-template-columns:repeat(32,1fr);
  gap:2px;margin-bottom:.5rem;
}
.coupling-cell{
  height:28px;border-radius:1px;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--mono);font-size:8px;color:transparent;
  transition:opacity .2s;cursor:default;
}
.coupling-cell:hover{opacity:.7}

/* LOG */
.log-list{display:flex;flex-direction:column;gap:0}
.log-item{
  display:grid;grid-template-columns:90px 1fr;gap:1rem;
  padding:1rem 0;border-bottom:1px solid var(--border);align-items:start;
}
.log-item:last-child{border-bottom:none}
.log-date{font-family:var(--mono);font-size:11px;color:var(--muted);padding-top:2px}
.log-title{font-size:.9rem;color:var(--text);margin-bottom:.35rem}
.log-body{font-size:.82rem;color:var(--muted);line-height:1.6}
.log-tags{display:flex;gap:5px;margin-top:.4rem;flex-wrap:wrap}
.log-tag{font-family:var(--mono);font-size:9px;padding:2px 6px;border:1px solid var(--border);color:var(--dim)}
.log-result{
  font-family:var(--mono);font-size:11px;
  background:var(--s2);border-left:2px solid var(--green);
  padding:.5rem .75rem;margin-top:.5rem;color:var(--muted);
  display:grid;grid-template-columns:1fr 1fr;gap:4px 1rem;
}
.log-result span{color:var(--green)}

/* BLACKBOARD */
.bb-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:700px){.bb-grid{grid-template-columns:1fr}}
.bb-card{
  background:var(--s1);border:1px solid var(--border);
  padding:1rem 1.25rem;
}
.bb-card h3{font-size:.85rem;font-weight:500;color:var(--text);margin-bottom:.5rem}
.bb-card p{font-size:.82rem;color:var(--muted);line-height:1.7}
.bb-card.open{border-left:2px solid var(--amber)}
.bb-card.closed{border-left:2px solid var(--green)}
.bb-card.pending{border-left:2px solid var(--blue)}
.bb-status{font-family:var(--mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem}
.bb-status.open{color:var(--amber)}
.bb-status.closed{color:var(--green)}
.bb-status.pending{color:var(--blue)}
.bb-formula{
  font-family:var(--mono);font-size:11px;
  background:var(--s2);border:1px solid var(--border);
  padding:.5rem .75rem;margin-top:.75rem;color:var(--green);
  line-height:1.6;
}

/* CONFIG TABLE */
.config-table{width:100%;border-collapse:collapse}
.config-table tr:hover td{background:var(--s2)}
.config-table td{padding:6px 10px;border-bottom:1px solid var(--border);font-size:12px}
.config-table td:first-child{font-family:var(--mono);font-size:11px;color:var(--muted);width:50%}
.config-table td:last-child{font-family:var(--mono);color:var(--green)}

/* SUMMARY L2 */
.l2-row{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border)}
.l2-row:last-child{border-bottom:none}
.l2-label{font-size:12px;color:var(--muted)}
.l2-val{font-family:var(--mono);font-size:12px;color:var(--green)}

/* MISC */
.mono{font-family:var(--mono)}
.text-muted{color:var(--muted)}
.text-green{color:var(--green)}
.text-amber{color:var(--amber)}
.mb1{margin-bottom:1rem}
.mb2{margin-bottom:2rem}

/* GUIDE-FIRST OVERVIEW */
.overview-hero{
  background:linear-gradient(135deg,var(--green3),rgba(96,165,250,.035));
  border:1px solid var(--border);border-left:2px solid var(--green);
  padding:1.4rem 1.5rem;margin-bottom:1.25rem;
}
.hero-kicker{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--green);margin-bottom:.45rem}
.hero-title{font-size:1.35rem;font-weight:400;line-height:1.3;margin-bottom:.55rem;color:var(--text)}
.hero-copy{font-size:14px;color:var(--muted);line-height:1.8;max-width:980px}
.guide-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:1.25rem;margin-bottom:1.5rem}
@media(max-width:980px){.guide-grid{grid-template-columns:1fr}}
.flow-rail{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:1.25rem}
@media(max-width:900px){.flow-rail{grid-template-columns:1fr 1fr}}
.flow-node{background:var(--s1);border:1px solid var(--border);padding:1rem;min-height:118px}
.flow-node strong{display:block;font-family:var(--mono);font-size:12px;color:var(--green);margin-bottom:.35rem}
.flow-node span{display:block;font-size:12px;color:var(--muted);line-height:1.65}
.metric-legend{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(max-width:760px){.metric-legend{grid-template-columns:1fr}}
.legend-card{background:var(--s2);border:1px solid var(--border);padding:.9rem}
.legend-name{font-family:var(--mono);font-size:11px;color:var(--text);margin-bottom:.35rem}
.legend-desc{font-size:12px;color:var(--muted);line-height:1.65}
.read-path{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:1.5rem}
@media(max-width:900px){.read-path{grid-template-columns:1fr 1fr}}
.path-card{background:var(--s1);border:1px solid var(--border);padding:.9rem}
.path-card .path-tab{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--green);margin-bottom:.4rem}
.path-card p{font-size:12px;color:var(--muted);line-height:1.65}
.verdict-box{background:var(--s1);border:1px solid var(--border);border-left:2px solid var(--amber);padding:1rem 1.25rem;margin-bottom:1.5rem}
.verdict-box strong{color:var(--text);font-weight:500}
.verdict-box p{font-size:13px;color:var(--muted);line-height:1.8}

</style>
</head>
<body>

<nav>
  <span class="nav-logo">demian // substrate</span>
  <div class="nav-tabs">
    <button class="nav-tab active" onclick="showPage('overview')">Overview</button>
    <button class="nav-tab" onclick="showPage('architecture')">Architecture</button>
    <button class="nav-tab" onclick="showPage('eeg')">EEG Mapping</button>
    <button class="nav-tab" onclick="showPage('experiments')">Experiments</button>
    <button class="nav-tab" onclick="showPage('log')">Log</button>
    <button class="nav-tab" onclick="showPage('blackboard')">Blackboard</button>
  </div>
  <div class="nav-right">
    <a class="nav-link" href="https://aeshma-daeva.github.io/Demian-Lab/updates.json">JSON</a>
    <a class="nav-link" href="https://aeshma-daeva.github.io/Demian-Lab/rss.xml">RSS</a>
    <span class="badge-live">v3 active</span>
  </div>
</nav>

<main>

<!-- ══════════════════════════════ OVERVIEW ══════════════════════════════ -->
<div class="page active" id="page-overview">
  <div class="overview-hero">
    <div class="hero-kicker">public blackboard · GitHub Pages + Discord feed</div>
    <div class="hero-title">Demian Lab is now a public progress board for the EEG adaptation work.</div>
    <p class="hero-copy">
      This standalone preview mirrors the Astro site direction: curated research posts, a status blackboard,
      and stable <strong style="color:var(--text)">updates.json</strong> / <strong style="color:var(--text)">rss.xml</strong>
      feeds that a Discord bot can poll without scraping fragile page markup. The detailed charts remain as a local run appendix.
    </p>
  </div>

  <div class="flow-rail">
    <div class="flow-node">
      <strong>1 · EEG artifacts</strong>
      <span>Experiment reports and metrics remain in the local EEG work folder and are treated as source artifacts.</span>
    </div>
    <div class="flow-node">
      <strong>2 · curated posts</strong>
      <span>Astro Markdown posts summarize what changed, what ran, what can be claimed, and what cannot.</span>
    </div>
    <div class="flow-node">
      <strong>3 · public feeds</strong>
      <span>The site emits updates.json and rss.xml with titles, tags, metrics, artifact paths, and canonical URLs.</span>
    </div>
    <div class="flow-node">
      <strong>4 · Discord relay</strong>
      <span>A bot can poll the feeds, route by tags, and organize updates into channels without bespoke scraping.</span>
    </div>
  </div>

  <div class="stat-row">
    <div class="stat-card accent">
      <div class="stat-val green">250</div>
      <div class="stat-label">recordings</div>
      <div class="stat-sub">historical saved-run sample</div>
    </div>
    <div class="stat-card">
      <div class="stat-val green">1.0</div>
      <div class="stat-label">positive growth fraction</div>
      <div class="stat-sub">recorded probe measure</div>
    </div>
    <div class="stat-card">
      <div class="stat-val amber">101/250</div>
      <div class="stat-label">reconvergent</div>
      <div class="stat-sub">bounded trajectories that reconverged</div>
    </div>
    <div class="stat-card">
      <div class="stat-val blue">v3</div>
      <div class="stat-label">architecture</div>
      <div class="stat-sub">active public progress phase</div>
    </div>
    <div class="stat-card">
      <div class="stat-val green">JSON</div>
      <div class="stat-label">discord feed</div>
      <div class="stat-sub">/updates.json · tags + metrics</div>
    </div>
    <div class="stat-card">
      <div class="stat-val green">RSS</div>
      <div class="stat-label">public syndication</div>
      <div class="stat-sub">/rss.xml · standard polling</div>
    </div>
  </div>

  <div class="guide-grid">
    <div class="panel">
      <div class="panel-title">metric legend — what each number means</div>
      <div class="metric-legend">
        <div class="legend-card">
          <div class="legend-name">tension reservoir</div>
          <div class="legend-desc">Accumulated internal pressure / memory. Rising means the model keeps integrating context instead of resetting.</div>
        </div>
        <div class="legend-card">
          <div class="legend-name">uncertainty</div>
          <div class="legend-desc">How unstable or unresolved the current state is. Read beside tension: high tension + high uncertainty means stored pressure without clean resolution.</div>
        </div>
        <div class="legend-card">
          <div class="legend-name">route tortuosity</div>
          <div class="legend-desc">How indirect the internal trajectory is. 1 is straight; higher values mean the state path bends, loops, or detours.</div>
        </div>
        <div class="legend-card">
          <div class="legend-name">self/other cosine</div>
          <div class="legend-desc">Alignment between Demian's self-trace and other/input trace. Negative means they remain separated, not merged.</div>
        </div>
        <div class="legend-card">
          <div class="legend-name">gate state norm</div>
          <div class="legend-desc">How much the gate has accumulated. Large non-zero values mean the gate is active and shaping channel flow.</div>
        </div>
        <div class="legend-card">
          <div class="legend-name">prediction error</div>
          <div class="legend-desc">Mismatch between expected and incoming state. Spikes are windows where the model had to update harder.</div>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-title">local run appendix readout</div>
      <div class="l2-row"><span class="l2-label">reservoir change</span><span class="l2-val">2.75 → 27.22</span></div>
      <div class="l2-row"><span class="l2-label">uncertainty final</span><span class="l2-val">3.14</span></div>
      <div class="l2-row"><span class="l2-label">fast/slow ratio final</span><span class="l2-val">1.37</span></div>
      <div class="l2-row"><span class="l2-label">prediction error final</span><span class="l2-val">2.44</span></div>
      <div class="l2-row"><span class="l2-label">mean |coupling| final</span><span class="l2-val">0.69</span></div>
      <div class="l2-row"><span class="l2-label">live vs gate-frozen L2</span><span class="l2-val">1.085</span></div>
      <div class="l2-row"><span class="l2-label">ordered vs shuffled L2</span><span class="l2-val">1.479</span></div>
      <p style="font-size:11px;color:var(--muted);margin-top:1rem;line-height:1.65">
        Interpretation: this local run appendix remains useful evidence, while the public blackboard headline is the 250-recording saved probe summary.
      </p>
    </div>
  </div>

  <div class="verdict-box">
    <p>
      <strong>Plain-English verdict:</strong> the saved probe records a bounded observer response to a small input perturbation.
      The local charts below show one detailed EEG-derived run appendix. Neither surface establishes brain-state decoding, diagnosis, biomarkers, or clinical relevance.
    </p>
  </div>

  <div class="section-label">navigation — what each tab is for</div>
  <div class="read-path">
    <div class="path-card"><div class="path-tab">Architecture</div><p>Internal channels, gate behavior, fast/slow competition, L2 ablations.</p></div>
    <div class="path-card"><div class="path-tab">EEG Mapping</div><p>How raw channels become band, region, asymmetry, and quality features.</p></div>
    <div class="path-card"><div class="path-tab">Experiments</div><p>Run-specific evidence: charts, findings, and sanity checks.</p></div>
    <div class="path-card"><div class="path-tab">Blackboard</div><p>Public status, feed contract, claims, open questions, and next hypotheses without overclaiming.</p></div>
  </div>

  <div class="grid-2">
    <div class="panel">
      <div class="panel-title">Tension dynamics over time</div>
      <div class="chart-wrap" style="height:200px"><canvas id="chart-tension" role="img" aria-label="Tension dynamics over time">Tension dynamics</canvas></div>
    </div>
    <div class="panel">
      <div class="panel-title">Tension reservoir accumulation</div>
      <div class="chart-wrap" style="height:200px"><canvas id="chart-reservoir" role="img" aria-label="Tension reservoir over time">Reservoir accumulation</canvas></div>
    </div>
  </div>

  <div class="grid-2">
    <div class="panel">
      <div class="panel-title">Route tortuosity (global)</div>
      <div class="chart-wrap" style="height:200px"><canvas id="chart-tort" role="img" aria-label="Route tortuosity over time">Route tortuosity</canvas></div>
    </div>
    <div class="panel">
      <div class="panel-title">Self / other cosine (trisequence)</div>
      <div class="chart-wrap" style="height:200px"><canvas id="chart-cos" role="img" aria-label="Self other cosine">Self other cosine</canvas></div>
    </div>
  </div>

  <div class="grid-2">
    <div class="panel">
      <div class="panel-title">Prediction error (per window)</div>
      <div class="chart-wrap" style="height:160px"><canvas id="chart-pred" role="img" aria-label="Prediction error per window">Prediction error</canvas></div>
    </div>
    <div class="panel">
      <div class="panel-title">Mean absolute coupling (32-dim)</div>
      <div class="chart-wrap" style="height:160px"><canvas id="chart-coupling" role="img" aria-label="Mean absolute coupling over time">Coupling time series</canvas></div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title">Final coupling weights — 32 hidden dimensions</div>
    <div class="coupling-heat" id="coupling-heat"></div>
    <div style="display:flex;gap:1.5rem;font-family:var(--mono);font-size:10px;color:var(--muted);margin-top:.5rem;flex-wrap:wrap">
      <span style="color:var(--red)">■ negative</span>
      <span style="color:var(--green)">■ positive</span>
      <span>range: -0.98 → 0.98 · L2 4.15</span>
    </div>
  </div>
</div>

<!-- ══════════════════════════════ ARCHITECTURE ══════════════════════════════ -->
<div class="page" id="page-architecture">
  <div class="section-label">internal channels — demian_v1_trisequence_tension_v3</div>

  <div class="grid-arch">
    <div>
      <div class="channel-grid" id="ch-grid"></div>
    </div>
    <div class="panel" id="ch-detail" style="min-height:300px">
